# ============================================
# Reiki & Sage — Environment Variables
# ============================================
# Copy this to .env.local for local development
# Add these to Vercel Dashboard → Settings → Environment Variables for production
# ============================================

# Firebase (Client-side — safe to expose, protected by Firebase security rules)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Stripe (Client-side — publishable key is safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Dev Sandbox Admin Password (safe for local development only)
VITE_DEV_ADMIN_PASSWORD=ChangeMeForProduction_StrongPass!

# ============================================
# SERVER-SIDE ONLY — Add these in Vercel Dashboard only
# DO NOT commit actual secrets to git repository
# ============================================
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Resend Email Integration (Server-side)
# RESEND_API_KEY=re_your_resend_api_key_here
# FROM_EMAIL=Reiki & Sage <healing@reikiandsage.com>
# HEALER_EMAIL=carissa@reikiandsage.com
# NEXT_PUBLIC_SITE_URL=https://reikiandsage.com

