// Firestore Security Rules for Reiki & Sage
// Deploy via: firebase deploy --only firestore:rules
// Or paste into Firebase Console → Firestore → Rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the user is an admin/owner (exclusively Jason & Carissa)
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email.lower() in ['jasonmounts77@yahoo.com', 'carissabright@gmail.com'];
    }

    // Helper: check if user is staff+ (exclusively Jason & Carissa)
    function isStaff() {
      return request.auth != null &&
        request.auth.token.email.lower() in ['jasonmounts77@yahoo.com', 'carissabright@gmail.com'];
    }

    // Profiles: users can read/update own; admins can read all.
    // Prevent self-promotion to admin/owner roles.
    match /profiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId && 
                    (request.resource.data.role == 'seeker' || 
                     (request.resource.data.role in ['admin', 'owner'] && request.auth.token.email.lower() in ['jasonmounts77@yahoo.com', 'carissabright@gmail.com']));
      allow update: if request.auth != null && (
        (request.auth.uid == userId && (request.resource.data.role == resource.data.role || (request.resource.data.role in ['admin', 'owner'] && request.auth.token.email.lower() in ['jasonmounts77@yahoo.com', 'carissabright@gmail.com']))) || 
        isAdmin()
      );
      allow delete: if false; // Never delete profiles from client
    }

    // Applications: users can create; users can read own; staff+ can read all; admins can update
    match /applications/{appId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isStaff());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Stories: anyone can read approved; users can create; admins can update status
    match /stories/{storyId} {
      allow read: if resource.data.status == 'approved' ||
        (request.auth != null && resource.data.userId == request.auth.uid) ||
        isStaff();
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Session logs: users can read/create own only
    match /session_logs/{logId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Pricing plans: anyone can read
    match /pricing_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings: staff+ can read/write; authenticated clients can read their own bookings
    match /bookings/{bookingId} {
      allow read: if isStaff() || 
        (request.auth != null && 
          (resource.data.customerEmail == request.auth.token.email || 
           resource.data.userId == request.auth.uid));
      allow create, update: if isStaff() || request.auth != null;
      allow delete: if isAdmin();
    }

    // Settings: bank_info read/write restricted to admin; others read by all, write by staff+
    match /settings/{settingId} {
      allow read: if settingId != 'bank_info' || isAdmin();
      allow write: if (settingId == 'bank_info' && isAdmin()) || (settingId != 'bank_info' && isStaff());
    }

    // Immutable ledger: only admins can read; client writes/updates/deletes are strictly blocked
    match /ledger/{ledgerId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
